<%- include('partials/header') %>

<link
  href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
  rel="stylesheet"
  integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
  crossorigin="anonymous"
/>
<link rel="stylesheet" type="text/css" href="/css/styles2.css" />

<div class="container col-xxl-8 px-4 py-5">
  <div class="row flex-lg-row-reverse align-items-center g-5 py-5">
    <div class="col-10 col-sm-8 col-lg-6">
      <img
        src="/images/1.png"
        class="d-block mx-lg-auto img-fluid"
        alt="Blog"
        width="700"
        height="500"
        loading="lazy"
      />
    </div>
    <div class="col-lg-6">
      <h1 class="display-5 fw-bold text-body-emphasis lh-1 mb-3">
        Share Your Story, Inspire the Journey
      </h1>
      <p class="lead">
        Everyone has a story to tell. By sharing your experiences, you not only
        ease your own heart but also give hope and strength to others. Whether
        it's a small victory or a tough challenge, your words can make a
        difference. Join our community and let your story inspire someone
        today!
      </p>
      <div class="d-grid gap-2 d-md-flex justify-content-md-start">
        <!-- Create Button -->
        <a href="/create" class="btn btn-outline-secondary btn-lg px-4">Create</a>

        <!-- Read Button -->
        <!-- <a href="/community" class="btn btn-outline-secondary btn-lg px-4">Read</a> -->
      </div>
    </div>
  </div>
</div>

<div class="sep"></div>

<!-- Blog Posts List -->
<div class="container mt-5">
  <h2 class="text-center mb-4">Recent Stories</h2>
  <ul class="list-group">
    <% if (posts && posts.length > 0) { %>
      <% posts.forEach(post => { %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <!-- Correct Post Link -->
            <a
              href="/post/<%= post.post_id %>"
              class="text-decoration-none text-dark fw-bold"
            >
              <%= post.title %>
            </a>
          </div>
          <!-- Delete Button Form with method override -->
          <form
            action="/delete/<%= post.post_id %>?_method=DELETE"
            method="POST"
            onsubmit="return confirm('Are you sure you want to delete this post?');"
          >
            <!-- Hidden input to tell method-override to convert POST to DELETE -->
            <input type="hidden" name="_method" value="DELETE" />
            <button type="submit" class="btn btn-outline-danger btn-sm">
              Delete
            </button>
          </form>
        </li>
      <% }) %>
    <% } else { %>
      <li class="list-group-item text-center">
        <em>No posts available. Be the first to share your story!</em>
      </li>
    <% } %>
  </ul>
</div>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
  crossorigin="anonymous"
></script>

<%- include('partials/footer') %>
