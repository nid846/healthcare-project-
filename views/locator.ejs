<%- include('partials/header') %>

<style>
    body {
        background-color: lightblue;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
    }

    .map-container {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 80vh;
    }

    iframe {
        width: 74%;
        height: 80vh;
        border: none;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);
    }

    h1, h2 {
        position: fixed;
        left: 50%;
        transform: translateX(-50%);
        width: auto;
        max-width: 90%;
        background: linear-gradient(135deg, #823fc9, #356bc7);
        color: white;
        padding: 15px 20px;
        font-size: 1.2rem;
        font-weight: bold;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
        text-align: center;
    }

    h1 {
        top: 2%;
    }

    h2 {
        top: 8%;
    }

    .message {
        padding-top: 80px;
        text-align: center;
    }

    @media (max-width: 768px) {
        iframe {
            width: 95%;
            height: 70vh;
        }

        h1, h2 {
            font-size: 1rem;
            padding: 10px;
        }
    }
    img {
    margin:1rem;
    height: 200px;
    width: 300px;
    background-color: white;
    align-items: flex-start;
    border-radius: 5px 5px 5px 5px;
}

</style>

<h1 class="mes">Support. Care. Empower.</h1>
<div class="message">
    <h2>Because every human deserves the best start, the right education, and a helping hand.</h2>
</div>
<div class="map-container">
    <img src="../images/legend.png">
    <iframe src="https://www.google.com/maps/d/u/0/embed?mid=121OWnLgWE6C-YKYZW9JVcplMscgelIQ&ehbc=2E312F"></iframe>
</div>
<%- include('partials/footer') %>
