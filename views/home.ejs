<%- include('partials/header') %>

<link rel="stylesheet" type="text/css" href="/css/styles.css" />
<div class="container">
  <div class="login-box">
    <h2>Welcome Back!</h2>
    <div id="message" class="alert" style="display: none"></div>

    <form id="login-form">
      <div class="input-group">
        <label for="username">Email</label>
        <input type="email" id="username" name="username" required />
      </div>
      <div class="input-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
      </div>
      <button type="submit" class="btn">Login</button>
    </form>

    <p>Don't have an account? <a href="/register">Register</a></p>

    <div class="google-login">
      <p>Or log in with:</p>
      <a href="/auth/google" class="btn google-btn">
        <img src="/images/google-icon.png" alt="Google Logo" />
        Login with Google
      </a>
    </div>
  </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
  $("#login-form").submit(function (e) {
    e.preventDefault();
    $.ajax({
      type: "POST",
      url: "/login",
      data: $("#login-form").serialize(),
      success: function (response) {
        $("#message").removeClass().addClass(response.class);
        $("#message").html(response.message).fadeIn();
        if (response.success) {
          setTimeout(function () {
            window.location.href = "/open";
          }, 2000);
        }
      },

      error: function () {
        $("#message").removeClass().addClass("alert alert-danger");
        $("#message").html("An error occurred. Please try again.").fadeIn();
      },
    });
  });
</script>

<%- include('partials/footer') %>
